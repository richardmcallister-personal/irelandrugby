{
  "name": "irelandrugby",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "irelandrugby.wiki", "custom_domain": true },
    { "pattern": "www.irelandrugby.wiki", "custom_domain": true }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [
    { "binding": "CACHE", "id": "372a7fc7187c412f919b8fbc1eac975a" }
  ],
  "triggers": { "crons": ["7 */6 * * *"] },
  "observability": { "enabled": true }
}
